<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GesterTask.ViewModels"
             x:Class="GesterTask.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Resumen">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Header -->
            <Label Text="Panel de Estadísticas"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#512BD4, Dark=#9B7FFF}" />

            <Label Text="Aquí puedes ver un resumen rápido de tus tareas."
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />

            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="16"
                  Margin="0,10">

                <!-- Pending Tasks Card -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="OrangeRed"
                        Padding="16">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="⏳"
                               FontSize="32"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding PendingCount}"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Tareas Pendientes"
                               FontSize="13"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Completed Tasks Card -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="Green"
                        Padding="16">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="✅"
                               FontSize="32"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CompletedCount}"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Tareas Completadas"
                               FontSize="13"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Info Section -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#DDD, Dark=#444}"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="SpaceBetween"
                            AlignItems="Center">
                    <Label Text="💡 Toca 'Mis Tareas' para ver y gestionar todas tus tareas."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"
                           FlexLayout.Grow="1" />
                </FlexLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
